---
extends: default
ignore: |
  .git/
  .ansible/
  .venv/
  .cache/
  inventory/group_vars/valkey_nodes/vault.yml
rules:
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  line-length:
    max: 140
  comments:
    min-spaces-from-content: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
